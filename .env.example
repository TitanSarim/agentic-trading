# Copy to .env on the Windows app host. Env overrides config file defaults.

# Ollama on Linux .22 (LAN). Prefer env for machine-specific overrides.
OLLAMA_BASE_URL=http://192.168.8.22:11434
# Optional: OLLAMA_ANALYST_MODEL=qwen3.8:27b
# Optional: OLLAMA_SCREEN_MODEL=qwen3.5:9b
# Optional: OLLAMA_BACKEND=mock   # force offline MockLlm in CI

# Optional: path to YAML config (default: config/default.yaml)
# TRADER_CONFIG=config/default.yaml

# Optional: SQLite path override
# TRADER_DB_PATH=data/trader.db

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
# TRADER_LOG_LEVEL=INFO

# Optional: broker backend (mock | mt5). Use mt5 only on Windows with terminal running.
# TRADER_BROKER_BACKEND=mock

# Demo is required for P6. Live refused unless TRADER_ALLOW_LIVE=true (P9).
# TRADER_BROKER_MODE=demo
# TRADER_ACCOUNT_MODE=demo
# TRADER_ALLOW_LIVE=false

# Never put MT5 account password in the repo. Use local .env only on Windows.
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=ICMarketsSC-Demo
